# VERSION — Project Memory Load State
# ⭐ This file is the load state persisted to disk. It is loaded FIRST on every
# first-turn activation. It drives the Load State Machine.
# Format is identical across project-memory and project-memory-compact variants
# so the knowledge base stays compatible when switching variants.

# Monotonically increasing version. Bump on EVERY archive write (V1 → V2 → ...).
# This number is echoed in the in-context marker [PMEM_LOADED:Vx].
loaded_version: 1

# Current code version when last synced. Use git HEAD short hash,
# or "no-git" if the project is not under git.
code_fingerprint: "no-git"

# ISO 8601 timestamp of the last sync/verify/write.
last_sync: "2026-07-29T00:00:00Z"

# Recent change summaries (max 10, drop oldest).
# In continuation mode, when an external change is signaled, read ONLY this list
# to decide which entries to re-examine — instead of reloading everything.
recent_changes:
